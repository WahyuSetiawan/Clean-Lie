# Dev shell otomatis saat masuk direktori ini (direnv).
#
# Butuh: direnv + nix (flake). Sangat disarankan nix-direnv agar hasil
# `nix print-dev-env` di-cache dan prompt tidak lambat:
#   https://github.com/nix-community/nix-direnv
#
# Aktifkan sekali per mesin:
#   echo 'source $HOME/.nix-profile/share/nix-direnv/direnvrc' >> ~/.config/direnv/direnvrc
#
# Lalu di repo ini:
#   direnv allow

# Muat ulang shell kalau flake berubah.
watch_file flake.nix flake.lock

if ! has nix_direnv_version 2>/dev/null; then
  echo "direnv: nix-direnv belum aktif; 'use flake' tetap jalan tapi evaluasi ulang tiap masuk." >&2
  echo "direnv: pasang nix-direnv untuk cache: https://github.com/nix-community/nix-direnv" >&2
fi

use flake
